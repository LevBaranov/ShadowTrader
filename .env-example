DB_USER=postgres_user
DB_PASSWORD=postgres_password
DB_NAME=postgres_db
DB_HOST=db
DB_PORT=5432


SECRET_KEY=supersecret
JWT_ISSUER=
JWT_AUDIENCE=

# Ключ шифрования брокерских токенов (Fernet, url-safe base64, 32 байта).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

#SMTP_HOST=
#SMTP_PORT=
#SMTP_USER=
#SMTP_PASSWORD=
#EMAIL_FROM=

# --- Telegram-бот ---
# Токен бота (BotFather). Используется процессом бота и планировщиком (уведомления).
TELEGRAM_BOT_TOKEN=
# Сервисный ключ бота: защищает /service/telegram/* на бэкенде. Один и тот же у api и bot.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
BOT_API_KEY=
# Публичный адрес веб-приложения — для диплинка привязки Telegram ({WEB_APP_URL}/link-telegram?code=...)
WEB_APP_URL=http://localhost
# Прокси до Telegram API, если прямой доступ закрыт (напр. socks5://127.0.0.1:1080).
#TELEGRAM_PROXY=

# Интервал прохода планировщика по задачам, сек (по умолчанию 300).
#SCHEDULER_INTERVAL_SEC=300

# --- Мосбиржа ---
# Точка входа в ISS и размер страницы при выгрузке состава индекса.
#MOEX_BASE_URL=https://iss.moex.com/iss
#MOEX_INDEX_LIMIT=100

# --- Логи ---
# Единственный источник настроек логирования — эти переменные.
# Каталог логов внутри контейнера; смонтирован на хост в docker-compose
# (./logs/api, ./logs/scheduler, ./logs/bot). По умолчанию — logs/ в корне проекта.
#LOG_PATH=/app/logs
# 0 — писать только в stdout, файлы не создавать.
#LOG_ENABLED=1
# 1 — подробный режим: к каждому вызову интеграции добавляется строка с запросом/ответом.
#LOG_VERBOSE=0
#LOG_LEVEL=INFO


VERSION=v0.5.0
